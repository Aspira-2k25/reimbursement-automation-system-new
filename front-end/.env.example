# ==============================================================================
# Frontend Environment Configuration Template (.env.example)
# Reimbursement Automation System (Vite + React)
# ==============================================================================

# Backend API Base URL (e.g. http://localhost:5000/api for local dev, or https://your-backend.onrender.com/api in production)
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
