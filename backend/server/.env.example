# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PREVIEW=

# Authentication Secrets
# JWT_SECRET must be at least 64 characters in production
JWT_SECRET=your_64_character_or_longer_random_secret_here_minimum_sixty_four_chars
JWT_EXPIRES_IN=15m
# REFRESH_TOKEN_SECRET must be distinct from JWT_SECRET
REFRESH_TOKEN_SECRET=your_64_character_refresh_token_secret_here_distinct_from_jwt_secret
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
INSTITUTIONAL_EMAIL_DOMAIN=apsit.edu.in

# PostgreSQL Database (Prisma)
DB_POSTGRES_URL=postgres://user:password@localhost:5432/reimburse
DATABASE_URL=postgres://user:password@localhost:5432/reimburse
DB_PRISMA_DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=your_prisma_accelerate_key

# MongoDB Database (Mongoose)
MONGO_URI=mongodb://localhost:27017/reimburse

# Redis URL (BullMQ Job Queue)
REDIS_URL=redis://localhost:6379

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# Email Service (Resend / SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Security & CSP
CSP_REPORT_ONLY=false
CSP_REPORT_URI=/api/csp-report

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
