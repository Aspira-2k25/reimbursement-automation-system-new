# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# Reimbursement Automation System
# ==============================================================================

# Server Port and Environment (development | production | test)
PORT=5000
NODE_ENV=development
DEBUG=false

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PREVIEW=http://localhost:4173

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_character_or_longer_secure_random_jwt_secret_key_here
REFRESH_TOKEN_SECRET=your_64_character_or_longer_different_secure_refresh_secret_key_here
CSRF_SECRET=your_64_character_or_longer_csrf_secret_key_here
JWT_EXPIRES_IN=15m

# Institutional Email Domain
INSTITUTIONAL_EMAIL_DOMAIN=apsit.edu.in

# Google OAuth 2.0 Client ID (matching Google Cloud Console OAuth App)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Databases Configuration
# ------------------------------------------------------------------------------
# MongoDB Connection String (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/reimbursement_db?retryWrites=true&w=majority

# PostgreSQL Connection (Prisma & pg Pool)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DB_POSTGRES_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DB_PRISMA_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public

# ------------------------------------------------------------------------------
# Redis & Background Workers (BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# Cloudinary Storage (Document & Receipt Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# ------------------------------------------------------------------------------
# Email Service (Resend for Notifications & OTPs)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=reimbursements@yourdomain.edu

# ------------------------------------------------------------------------------
# Rate Limiting (express-rate-limit) & CSP
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CSP_REPORT_URI=/api/csp-report
CSP_REPORT_ONLY=false
